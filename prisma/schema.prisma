// Automotive Sales CRM — Database Schema
// SQLite (file-based, zero external services required for v1).
// SQLite has no native enum support in Prisma, so fixed-choice fields are
// typed as String and validated/typed at the application layer (see
// src/lib/constants.ts for the canonical value lists / TS union types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH / USERS / ROLES
// ─────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SALESPERSON | MANAGER | ADMIN (extensible)
  label       String
  description String?
  permissions String // JSON-encoded permission flags
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique
  passwordHash      String
  phone             String?
  avatarColor       String    @default("#2563eb")
  title             String? // e.g. "Sales Consultant"
  isActive          Boolean   @default(true)
  roleId            String
  role              Role      @relation(fields: [roleId], references: [id])
  notificationPrefs String? // JSON-encoded notification preferences
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  customers      Customer[]           @relation("CustomerOwner")
  leads          Lead[]               @relation("LeadAssignee")
  tasks          Task[]               @relation("TaskAssignee")
  appointments   Appointment[]        @relation("AppointmentSalesperson")
  testDrives     TestDrive[]          @relation("TestDriveSalesperson")
  activities     Activity[]           @relation("ActivityActor")
  communications Communication[]      @relation("CommunicationActor")
  notes          Note[]               @relation("NoteAuthor")
  sales          Sale[]               @relation("SaleSalesperson")
  notifications  Notification[]
  resetTokens    PasswordResetToken[]
  sessions       Session[]
  followUps      FollowUp[]           @relation("FollowUpAssignee")

  tiktokConversations      TikTokConversation[] @relation("TikTokConversationAssignee")
  tiktokEscalationsHandled TikTokEscalation[]   @relation("TikTokEscalationResolver")
  tiktokKnowledgeAdded     TikTokKnowledge[]    @relation("TikTokKnowledgeAuthor")
  tiktokMessagesSent       TikTokMessage[]      @relation("TikTokMessageHuman")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// CUSTOMERS / LEADS
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id                     String  @id @default(cuid())
  firstName              String
  lastName               String
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  zip                    String?
  preferredContactMethod String  @default("PHONE") // PHONE | TEXT | EMAIL
  bestContactTime        String? // MORNING | AFTERNOON | EVENING | ANYTIME

  ownerId String
  owner   User   @relation("CustomerOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads               Lead[]
  vehicleInterests    CustomerVehicle[]
  tradeIns            TradeIn[]
  appointments        Appointment[]
  testDrives          TestDrive[]
  tasks               Task[]
  communications      Communication[]
  notes               Note[]
  offers              Offer[]
  sales               Sale[]
  activities          Activity[]
  followUpEnrollments FollowUpEnrollment[]
  followUps           FollowUp[]
  tiktokConversations TikTokConversation[]

  @@index([lastName, firstName])
}

model LeadSource {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  order  Int     @default(0)
  leads  Lead[]
}

model PipelineStage {
  id           String  @id @default(cuid())
  name         String  @unique
  order        Int
  color        String  @default("#64748b")
  isClosedWon  Boolean @default(false)
  isClosedLost Boolean @default(false)
  active       Boolean @default(true)
  leads        Lead[]
}

model LostReason {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  order  Int     @default(0)
  leads  Lead[]
}

model Lead {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  assigneeId String
  assignee   User   @relation("LeadAssignee", fields: [assigneeId], references: [id])

  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  stageEnteredAt DateTime      @default(now())

  status            String  @default("ACTIVE") // ACTIVE | ON_HOLD | SOLD | LOST
  temperature       String  @default("COLD") // HOT | WARM | COLD
  score             Int     @default(0)
  purchaseTimeframe String? // IMMEDIATE | THIS_WEEK | THIS_MONTH | THIS_QUARTER | RESEARCHING

  dateReceived DateTime @default(now())

  // Financing
  financeType     String? // CASH | FINANCE | LEASE
  desiredPayment  Float?
  downPayment     Float?
  creditAppStatus String  @default("NOT_STARTED") // NOT_STARTED | SUBMITTED | APPROVED | DECLINED | PENDING
  hasCoBuyer      Boolean @default(false)
  coBuyerName     String?

  // Vehicle matching preferences (used for inventory search)
  prefBodyStyle  String?
  prefMaxPrice   Float?
  prefDrivetrain String?
  prefThirdRow   Boolean @default(false)
  prefColor      String?

  // Notes
  customerNeeds String?
  customerWants String?
  objections    String?
  preferences   String?
  salesNotes    String?

  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  lostReasonId String?
  lostReason   LostReason? @relation(fields: [lostReasonId], references: [id])
  lostAt       DateTime?
  lostNotes    String?

  soldAt DateTime?

  reactivatedAt     DateTime?
  reactivationCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleInterests    CustomerVehicle[]
  tasks               Task[]
  activities          Activity[]
  scoreEvents         LeadScoreEvent[]
  followUpEnrollments FollowUpEnrollment[]
  sales               Sale[]
  followUps           FollowUp[]
  appointments        Appointment[]
  tiktokConversations TikTokConversation[]

  @@index([assigneeId, status])
  @@index([temperature])
  @@index([stageId])
}

model LeadScoreEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// VEHICLES / INVENTORY / MATCHING
// ─────────────────────────────────────────────────────────────────────────

model Vehicle {
  id              String   @id @default(cuid())
  stockNumber     String   @unique
  vin             String   @unique
  year            Int
  make            String
  model           String
  trim            String?
  condition       String   @default("USED") // NEW | USED | CERTIFIED
  bodyStyle       String? // SEDAN | SUV | TRUCK | COUPE | VAN | CONVERTIBLE
  drivetrain      String? // FWD | RWD | AWD | 4WD
  mileage         Int      @default(0)
  exteriorColor   String?
  interiorColor   String?
  msrp            Float?
  sellingPrice    Float?
  internetPrice   Float?
  status          String   @default("AVAILABLE") // AVAILABLE | HOLD | SOLD | IN_TRANSIT | UNAVAILABLE
  location        String?
  photos          String? // JSON-encoded array of photo URLs
  description     String?
  seatingCapacity Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customerInterests CustomerVehicle[]
  appointments      Appointment[]
  testDrives        TestDrive[]
  offers            Offer[]
  sales             Sale[]

  @@index([status])
  @@index([make, model])
}

model CustomerVehicle {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])

  // Free-text fallback when no exact inventory match exists yet
  year  Int?
  make  String?
  model String?
  trim  String?

  isPrimary     Boolean  @default(false)
  interestLevel String   @default("INTERESTED") // INTERESTED | STRONG | PURCHASED | PASSED
  createdAt     DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// TRADE-INS
// ─────────────────────────────────────────────────────────────────────────

model TradeIn {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  year            Int?
  make            String?
  model           String?
  trim            String?
  vin             String?
  mileage         Int?
  payoff          Float    @default(0)
  estimatedValue  Float    @default(0)
  desiredValue    Float?
  appraisalStatus String   @default("PENDING") // PENDING | APPRAISED | ACCEPTED | DECLINED
  photos          String? // JSON array
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// APPOINTMENTS / TEST DRIVES
// ─────────────────────────────────────────────────────────────────────────

// Also serves as the CRM's calendar event — every entry here is what
// renders on the Calendar tab (month/week/day views), the dashboard's
// upcoming-activities widgets, and the customer profile's "Add to
// Calendar" list. leadId is optional (an appointment can be logged
// against a customer with no active lead), customerId is always required
// so it always shows on the customer's profile.
model Appointment {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  salespersonId String
  salesperson   User     @relation("AppointmentSalesperson", fields: [salespersonId], references: [id])

  date     DateTime // date component
  time     String // start time, "HH:mm"
  endTime  String? // "HH:mm"
  location String?
  type     String   @default("SALES_APPOINTMENT") // CUSTOMER_CALL | FOLLOW_UP_CALL | TEST_DRIVE | DEALERSHIP_APPOINTMENT | VEHICLE_WALKAROUND | FINANCING_DISCUSSION | TRADE_IN_EVALUATION | SALES_APPOINTMENT | DELIVERY | OTHER
  status   String   @default("SCHEDULED") // SCHEDULED | CONFIRMED | SHOWED | NO_SHOW | CANCELLED | COMPLETED
  notes    String?

  // Reminder: minutes before start to surface an in-app reminder
  // notification (0 = at the scheduled time). Null = no reminder.
  reminderOffsetMinutes Int?
  reminderSentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testDrives TestDrive[]

  @@index([date])
  @@index([status])
  @@index([leadId])
}

// A manually-scheduled follow-up call/touch on a specific customer (and
// optionally a specific lead) — distinct from the generic Task list and
// from calendar Appointments. Carries the conversation plan going in
// (topic + notes) and, once done, what actually happened
// (completionNotes). Rescheduling creates a new row linked back via
// rescheduledFromId so the history of a follow-up chain is never lost.
model FollowUp {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  topic String // Conversation Topic / Reason for Follow-Up
  notes String? // Detailed Follow-Up Notes — what to cover on the call

  followUpDate DateTime // date component
  followUpTime String // "HH:mm"

  // Minutes before followUpDate+Time to fire an in-app reminder
  // notification (0 = at the scheduled time, e.g. 15/30/60/1440, or any
  // custom value). Null = no reminder.
  reminderOffsetMinutes Int?
  reminderSentAt        DateTime?

  priority String @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status   String @default("SCHEDULED") // SCHEDULED | COMPLETED | RESCHEDULED | CANCELLED | MISSED
  // "Due Today" isn't stored — it's SCHEDULED + followUpDate == today,
  // computed at read time so it never needs a background job to stay
  // accurate as the day rolls over.

  assigneeId String
  assignee   User   @relation("FollowUpAssignee", fields: [assigneeId], references: [id])

  completedAt     DateTime?
  completionNotes String? // what happened during the call

  rescheduledFromId String?   @unique
  rescheduledFrom   FollowUp? @relation("FollowUpReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     FollowUp? @relation("FollowUpReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status, followUpDate])
  @@index([customerId])
  @@index([followUpDate])
}

model TestDrive {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId     String
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  salespersonId String
  salesperson   User         @relation("TestDriveSalesperson", fields: [salespersonId], references: [id])

  date             DateTime
  startTime        String?
  endTime          String?
  notes            String?
  customerReaction String? // POSITIVE | NEUTRAL | NEGATIVE
  objections       String?
  nextStep         String?

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// TASKS / ACTIVITIES / COMMUNICATIONS / NOTES
// ─────────────────────────────────────────────────────────────────────────

model Task {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  title    String
  type     String   @default("OTHER") // CALL | TEXT | EMAIL | FOLLOW_UP | APPOINTMENT | TRADE | CREDIT | DELIVERY | OTHER
  priority String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueDate  DateTime
  dueTime  String?
  status   String   @default("PENDING") // PENDING | COMPLETED | SNOOZED | CANCELLED
  notes    String?

  assigneeId String
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  source      String    @default("MANUAL") // MANUAL | AUTOMATION | SEQUENCE
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId, status, dueDate])
}

model Activity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  type        String // e.g. STAGE_CHANGE, NOTE_ADDED, CALL_LOGGED, TASK_COMPLETED, APPOINTMENT_SET, AUTOMATION, SOLD, LOST, REACTIVATED...
  description String
  metadata    String? // JSON

  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
}

model Communication {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type      String // CALL | TEXT | EMAIL | VOICEMAIL | IN_PERSON | OTHER
  direction String  @default("OUTBOUND") // OUTBOUND | INBOUND
  summary   String
  body      String?

  actorId String
  actor   User   @relation("CommunicationActor", fields: [actorId], references: [id])

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([customerId, occurredAt])
}

model Note {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?

  body String

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// OFFERS / SALES
// ─────────────────────────────────────────────────────────────────────────

model Offer {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])

  offerPrice     Float?
  monthlyPayment Float?
  term           Int?
  downPayment    Float?
  status         String  @default("PENDING") // PENDING | COUNTERED | ACCEPTED | REJECTED
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])

  salePrice   Float
  financeType String // CASH | FINANCE | LEASE
  saleDate    DateTime @default(now())

  salespersonId String
  salesperson   User   @relation("SaleSalesperson", fields: [salespersonId], references: [id])

  notes     String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// FOLLOW-UP SEQUENCES
// ─────────────────────────────────────────────────────────────────────────

model FollowUpSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  trigger     String   @default("NEW_LEAD") // NEW_LEAD | REACTIVATION | MANUAL
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  steps       FollowUpStep[]
  enrollments FollowUpEnrollment[]
}

model FollowUpStep {
  id          String           @id @default(cuid())
  sequenceId  String
  sequence    FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  dayOffset   Int
  type        String // CALL | TEXT | EMAIL | FOLLOW_UP | OTHER
  title       String
  description String?
  order       Int

  @@index([sequenceId, order])
}

model FollowUpEnrollment {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id])

  currentStepIndex Int       @default(0)
  status           String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
}

// ─────────────────────────────────────────────────────────────────────────
// AUTOMATION ENGINE
// ─────────────────────────────────────────────────────────────────────────

model AutomationRule {
  id           String   @id @default(cuid())
  name         String
  description  String?
  triggerEvent String // NEW_LEAD | STAGE_CHANGE | HOT_LEAD | APPOINTMENT_CREATED | APPOINTMENT_TOMORROW | APPOINTMENT_NO_SHOW | APPOINTMENT_COMPLETED | NO_CONTACT_X_DAYS | TEST_DRIVE_COMPLETED | VEHICLE_SOLD | LEAD_LOST | FOLLOW_UP_COMPLETED
  conditions   String? // JSON-encoded condition set
  actions      String // JSON-encoded array of actions to perform
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs AutomationRun[]
}

model AutomationRun {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  customerId String?
  leadId     String?
  status     String         @default("SUCCESS") // SUCCESS | SKIPPED | FAILED
  detail     String?
  createdAt  DateTime       @default(now())

  @@index([ruleId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS / SETTINGS
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String // NEW_LEAD | HOT_LEAD | OVERDUE_FOLLOW_UP | APPOINTMENT | APPOINTMENT_TOMORROW | NO_SHOW | CUSTOMER_ACTIVITY | VEHICLE_SOLD | IMPORTANT_TASK | AUTOMATION
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}

// Integration configuration placeholders (all disabled/absent by default).
// Populated later when external API keys become available; never required
// for v1 functionality.
model Integration {
  id        String   @id @default(cuid())
  provider  String   @unique // OPENAI | ANTHROPIC | TWILIO | GMAIL | OUTLOOK | GOOGLE_CALENDAR | DMS | INVENTORY_FEED | TIKTOK
  category  String // AI | SMS | EMAIL | CALENDAR | INVENTORY | LEADS | DMS | MESSAGING
  enabled   Boolean  @default(false)
  config    String? // JSON-encoded, non-secret config only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// TIKTOK AI MESSAGING ASSISTANT
//
// A conversation-understanding + confidence-gated response system for
// TikTok DMs. Built provider-agnostic on purpose (see src/lib/tiktok/) so
// the same pipeline can eventually drive Instagram, Messenger, SMS, or
// website chat — TikTok is just the first connector.
//
// TikTok does not offer a general public API for reading/sending a
// creator's own DMs; only approved Business Messaging partners get one
// (see README's "TikTok integration" section). Until that access is
// granted, TikTokMessage rows are populated by manually pasting in
// customer messages, and AI-drafted replies are copied out and sent by
// hand (or auto-marked SENT once approved) — the data model and pipeline
// underneath is already wired for a live webhook (see
// src/app/api/tiktok/webhook/route.ts) so plugging in real API access
// later requires no schema or UI changes.
// ─────────────────────────────────────────────────────────────────────────

// One row per TikTok DM thread == one customer profile (see spec section
// 13). Deliberately separate from the CRM's own Customer/Lead model so the
// TikTok assistant works standalone; `customerId`/`leadId` are populated
// once a conversation is qualified and converted into a real CRM lead.
model TikTokConversation {
  id                String  @id @default(cuid())
  tiktokUsername    String  @unique
  tiktokDisplayName String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId     String?

  assigneeId String?
  assignee   User?   @relation("TikTokConversationAssignee", fields: [assigneeId], references: [id])

  // Operating mode for this specific thread. Falls back to the global
  // default in TikTokAISettings when null (see src/lib/tiktok/pipeline.ts).
  mode String? // AUTO | DRAFT | OFF

  status      String @default("OPEN") // OPEN | HUMAN_REVIEW | CLOSED
  temperature String @default("COLD") // HOT | WARM | COLD | UNQUALIFIED | HUMAN_REVIEW

  // ── Collected profile (section 13) — populated gradually, never asked
  // for all at once (section 7: "no interrogating customers"). ──────────
  customerName          String?
  phone                 String?
  vehicleInterest       String? // free-text description ("BMW 3 Series", "reliable SUV")
  vehicleId             String? // set once matched to a real Vehicle
  desiredDownPayment    Float?
  desiredMonthlyPayment Float?
  creditNotes           String? // whatever the customer volunteers, verbatim — never inferred
  hasTradeIn            Boolean?
  tradeInNotes          String?
  hasLicense            Boolean?
  employmentStatus      String?
  applicationStatus     String    @default("NOT_STARTED") // NOT_STARTED | STARTED | SUBMITTED | COMPLETED
  appointmentRequested  Boolean   @default(false)
  appointmentAt         DateTime?

  // Freeform extracted facts that don't have a typed column yet (section
  // 12, context memory) — JSON array of {fact, sourceMessageId, at}.
  memory String?

  lastConfidence  Int?
  humanTakeoverAt DateTime?
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  unread          Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    TikTokMessage[]
  escalations TikTokEscalation[]
  lead        Lead?              @relation(fields: [leadId], references: [id])

  @@index([status])
  @@index([temperature])
  @@index([lastInboundAt])
}

model TikTokMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   TikTokConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction  String // IN | OUT
  senderType String // CUSTOMER | AI | HUMAN | SYSTEM

  rawBody String // exactly as received/typed, before normalization
  body    String // final text (== rawBody for inbound; the actual sent/drafted text for outbound)

  // ── Understanding Engine output (inbound only) ──────────────────────
  understanding    String? // JSON: { paraphrase, entities, referents, questions[] }
  intent           String? // see TIKTOK_INTENTS in src/lib/constants.ts
  confidence       Int? // 0-100, see src/lib/tiktok/confidence-engine.ts
  requiresHuman    Boolean @default(false)
  escalationReason String?

  // ── Outbound-only bookkeeping ────────────────────────────────────────
  status        String    @default("RECEIVED") // RECEIVED | DRAFT | QUEUED | SENT | BLOCKED
  aiGenerated   Boolean   @default(false)
  editedByHuman Boolean   @default(false)
  originalDraft String? // the AI's draft, kept even after a human edits it
  sentAt        DateTime?

  humanActorId String?
  humanActor   User?   @relation("TikTokMessageHuman", fields: [humanActorId], references: [id])

  createdAt DateTime @default(now())

  triggeredEscalations TikTokEscalation[]

  @@index([conversationId, createdAt])
}

// "HUMAN REVIEW REQUIRED" queue (spec section 9).
model TikTokEscalation {
  id             String             @id @default(cuid())
  conversationId String
  conversation   TikTokConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        TikTokMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  reason             String // LOW_CONFIDENCE | MISSING_INFO | AMBIGUOUS_REFERENT | ANGRY_CUSTOMER | LEGAL_THREAT | SENSITIVE_TOPIC | DISPUTE | COMPLAINT | UNAUTHORIZED_REQUEST | REQUESTED_HUMAN | HALLUCINATION_BLOCKED | COMPLEX
  aiInterpretation   String? // the Understanding Engine's paraphrase, for display
  intent             String?
  confidence         Int?
  suggestedResponses String? // JSON array of candidate replies for the human to pick from/edit

  status         String    @default("PENDING") // PENDING | RESOLVED
  resolvedById   String?
  resolvedBy     User?     @relation("TikTokEscalationResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([conversationId])
}

// Training Center content (spec sections 4, 5, 16): knowledge, examples,
// corrections, voice profile material, and dealership policy — all
// versioned and editable from the admin dashboard, no code changes.
model TikTokKnowledge {
  id String @id @default(cuid())

  type String
  // KNOWLEDGE      — general "here's how I explain X" material
  // FAQ            — question/answer pairs
  // POLICY         — fixed dealership facts (hours, location, process) the
  //                  AI is allowed to state verbatim
  // EXAMPLE        — a full example conversation pasted in to learn tone
  // CORRECTION     — "here's what I would have said instead" (section 5)
  // VOICE_EXAMPLE  — a message Chino likes, used as a style reference
  // PREFERRED_PHRASE / DO_NOT_SAY — vocabulary guidance

  title   String?
  content String // the actual text/example/correction
  tags    String? // comma-separated keywords used for retrieval matching

  // For CORRECTION rows: what the AI actually sent, for side-by-side context.
  sourceConversationId String?
  sourceMessageId      String?
  incorrectResponse    String?

  version Int     @default(1)
  active  Boolean @default(true)

  authorId String?
  author   User?   @relation("TikTokKnowledgeAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active])
}

// Global configuration for the assistant (spec sections 2, 10, 15).
// Single-row table — always read/write the row with id "default".
model TikTokAISettings {
  id String @id @default("default")

  mode String @default("DRAFT") // AUTO | DRAFT | OFF — global default; a conversation's own `mode` overrides this

  autoThreshold  Int @default(90) // >= this and no missing info -> may auto-send in AUTO mode
  draftThreshold Int @default(75) // >= this -> may draft for review; below -> escalate, no draft

  escalateOnAnger        Boolean @default(true)
  escalateOnLegalThreat  Boolean @default(true)
  escalateOnHumanRequest Boolean @default(true)

  businessName String?
  voiceNotes   String? // freeform description of Chino's communication style

  updatedAt DateTime @updatedAt
}
