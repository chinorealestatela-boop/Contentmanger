// Stratos Exotics & Lifestyle — CRM / Operations Platform
// Database Schema
// SQLite (file-based, zero external services required to run/demo).
// SQLite has no native enum support in Prisma, so fixed-choice fields are
// typed as String and validated/typed at the application layer (see
// src/lib/constants.ts for the canonical value lists / TS union types).
// Swap the datasource for Postgres/MySQL later with no application code
// changes (see scripts/generate-postgres-schema.mjs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH / EMPLOYEES / ROLES
// ─────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // OWNER | ADMIN | MANAGER | DISPATCHER | SALES | DRIVER
  label       String
  description String?
  permissions String // JSON-encoded permission flags
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique
  passwordHash      String
  phone             String?
  avatarColor       String    @default("#c9a24b")
  title             String? // e.g. "Concierge Manager", "Lead Chauffeur"
  isActive          Boolean   @default(true)
  roleId            String
  role              Role      @relation(fields: [roleId], references: [id])
  notificationPrefs String? // JSON-encoded notification preferences
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  customers      Customer[]           @relation("CustomerOwner")
  leads          Lead[]               @relation("LeadAssignee")
  tasks          Task[]               @relation("TaskAssignee")
  activities     Activity[]           @relation("ActivityActor")
  communications Communication[]      @relation("CommunicationActor")
  notes          Note[]               @relation("NoteAuthor")
  notifications  Notification[]
  resetTokens    PasswordResetToken[]
  sessions       Session[]
  followUps      FollowUp[]           @relation("FollowUpAssignee")
  quotesCreated  Quote[]              @relation("QuoteCreatedBy")
  driverProfile  Driver?
  documents      Document[]           @relation("DocumentUploadedBy")

  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// CUSTOMERS / LEADS
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id                     String  @id @default(cuid())
  firstName              String
  lastName               String
  phone                  String?
  email                  String?
  company                String?
  address                String?
  city                   String?
  state                  String?
  zip                    String?
  preferredContactMethod String  @default("PHONE") // PHONE | TEXT | EMAIL
  tier                   String  @default("STANDARD") // STANDARD | VIP | VVIP | CORPORATE
  preferredVehicleId     String?
  preferredVehicle       Vehicle? @relation("PreferredVehicle", fields: [preferredVehicleId], references: [id])
  preferredDriverId      String?
  preferredDriver        Driver? @relation("PreferredDriver", fields: [preferredDriverId], references: [id])
  specialRequests        String?
  referralSource         String?
  notes                  String?

  ownerId String
  owner   User   @relation("CustomerOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads          Lead[]
  bookings       Booking[]
  quotes         Quote[]
  payments       Payment[]
  tasks          Task[]
  communications Communication[]
  notes_         Note[]
  activities     Activity[]
  documents      Document[]
  followUps      FollowUp[]
  followUpEnrollments FollowUpEnrollment[]

  @@index([lastName, firstName])
  @@index([tier])
}

model LeadSource {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  order  Int     @default(0)
  leads  Lead[]
}

model PipelineStage {
  id           String  @id @default(cuid())
  name         String  @unique
  order        Int
  color        String  @default("#8a8a8a")
  isClosedWon  Boolean @default(false)
  isClosedLost Boolean @default(false)
  active       Boolean @default(true)
  leads        Lead[]
}

model LostReason {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  order  Int     @default(0)
  leads  Lead[]
}

model Lead {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  assigneeId String?
  assignee   User?  @relation("LeadAssignee", fields: [assigneeId], references: [id])

  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  stageEnteredAt DateTime      @default(now())

  status String @default("ACTIVE") // ACTIVE | ON_HOLD | BOOKED | LOST

  // Inquiry / trip details
  serviceRequested   String? // one of SERVICE_TYPES
  pickupLocation     String?
  dropoffLocation    String?
  serviceDate        DateTime?
  pickupTime         String?
  passengers         Int?
  vehicleRequested   String?
  vehicleId          String?
  vehicle            Vehicle? @relation(fields: [vehicleId], references: [id])
  chauffeurRequested Boolean  @default(true) // false = self-drive rental
  driverRequested    String?
  estimatedHours     Float?
  estimatedPrice     Float?
  budget             Float?

  isVip     Boolean @default(false) // flagged high-value by staff or AI
  score     Int     @default(0)
  rawInquiry String? // original inquiry text (website form / message) fed to the AI assistant
  aiSummary  String?
  aiExtracted String? // JSON-encoded structured fields the AI parsed out of rawInquiry

  notes String?

  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  lostReasonId String?
  lostReason   LostReason? @relation(fields: [lostReasonId], references: [id])
  lostAt       DateTime?
  lostNotes    String?

  bookedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks               Task[]
  activities          Activity[]
  scoreEvents         LeadScoreEvent[]
  communications      Communication[]
  quotes              Quote[]
  bookings            Booking[]
  followUps           FollowUp[]
  followUpEnrollments FollowUpEnrollment[]

  @@index([assigneeId, status])
  @@index([stageId])
  @@index([isVip])
}

model LeadScoreEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// FLEET / VEHICLES / MAINTENANCE / GPS
// ─────────────────────────────────────────────────────────────────────────

model Vehicle {
  id              String   @id @default(cuid())
  fleetNumber     String   @unique
  name            String // display name, e.g. "Rolls-Royce Cullinan — Black Badge"
  make            String
  model           String
  year            Int
  vin             String   @unique
  licensePlate    String?
  vehicleType     String // ROLLS_ROYCE | BENTLEY | MAYBACH | SPRINTER | ESCALADE | LAMBORGHINI | EXOTIC | SEDAN | SUV | OTHER
  color           String?
  seatingCapacity Int?
  photos          String? // JSON-encoded array of photo URLs
  currentMileage  Int      @default(0)
  availability    String   @default("AVAILABLE") // AVAILABLE | RESERVED | ON_TRIP | MAINTENANCE | OFFLINE
  currentLocation String?
  homeBase        String?

  assignedDriverId String?
  assignedDriver    Driver? @relation("AssignedVehicle", fields: [assignedDriverId], references: [id])

  hourlyRate         Float?
  dailyRate          Float?
  depositRequirement Float?

  insuranceProvider   String?
  insurancePolicyNo   String?
  insuranceExpiresAt  DateTime?
  registrationExpiresAt DateTime?

  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings            Booking[]
  leads               Lead[]
  maintenanceRecords  MaintenanceRecord[]
  gpsPings            VehicleGpsPing[]
  quotes              Quote[]
  preferredByCustomers Customer[] @relation("PreferredVehicle")
  documents           Document[]

  @@index([availability])
  @@index([vehicleType])
}

model MaintenanceRecord {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type           String // SERVICE | REPAIR | INSPECTION | DETAIL | TIRE | OIL_CHANGE | OTHER
  description    String
  status         String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  scheduledDate  DateTime?
  completedDate  DateTime?
  cost           Float?
  mileageAtService Int?
  vendor         String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vehicleId, status])
}

// Mock/latest telematics reading per vehicle. Architected so a real GPS
// provider (Samsara, Geotab, Verizon Connect, etc.) can write rows here
// through a webhook/poller without any UI changes — see
// src/lib/integrations/gps.ts.
model VehicleGpsPing {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  heading    Float?
  speedMph   Float?
  label      String? // human-readable nearest location, e.g. "Near LAX"
  recordedAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// DRIVERS / CHAUFFEURS
// ─────────────────────────────────────────────────────────────────────────

model Driver {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  firstName        String
  lastName         String
  phone            String?
  email            String?
  photoUrl         String?
  licenseNumber    String?
  licenseExpiresAt DateTime?
  certifications   String? // JSON-encoded array
  status           String  @default("AVAILABLE") // AVAILABLE | ASSIGNED | EN_ROUTE | WITH_CLIENT | COMPLETED | OFF_DUTY
  currentLocation  String?
  rating           Float?  @default(5)
  completedTrips   Int     @default(0)
  notes            String?
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignedVehicles      Vehicle[]  @relation("AssignedVehicle")
  bookings              Booking[]
  quotes                Quote[]
  preferredByCustomers  Customer[] @relation("PreferredDriver")
  documents             Document[]

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// SERVICES / LOCATIONS
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  baseRate    Float?
  active      Boolean @default(true)
  order       Int     @default(0)
}

model Location {
  id      String  @id @default(cuid())
  name    String
  address String?
  type    String  @default("OTHER") // AIRPORT | HOTEL | VENUE | RESIDENCE | OTHER
  notes   String?

  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────
// QUOTES
// ─────────────────────────────────────────────────────────────────────────

model Quote {
  id          String   @id @default(cuid())
  quoteNumber String   @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  serviceType     String?
  pickupLocation  String?
  dropoffLocation String?
  additionalStops String? // JSON array
  serviceDate     DateTime?
  pickupTime      String?
  hours           Float?
  distanceMiles   Float?
  amenities       String? // JSON array

  baseRate       Float   @default(0)
  driverFee      Float   @default(0)
  mileageFee     Float   @default(0)
  additionalFees Float   @default(0)
  discount       Float   @default(0)
  taxRate        Float   @default(0.0975)
  taxAmount      Float   @default(0)
  subtotal       Float   @default(0)
  totalPrice     Float   @default(0)
  depositAmount  Float   @default(0)

  status      String    @default("DRAFT") // DRAFT | SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED | CONVERTED
  validUntil  DateTime?
  termsText   String?
  sentAt      DateTime?
  respondedAt DateTime?

  convertedBookingId String? @unique
  convertedBooking   Booking? @relation("QuoteConvertedBooking", fields: [convertedBookingId], references: [id])

  createdById String?
  createdBy   User?   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// BOOKINGS / RESERVATIONS / TRIPS
// ─────────────────────────────────────────────────────────────────────────

model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  serviceType     String // one of SERVICE_TYPES
  pickupAddress   String?
  dropoffAddress  String?
  additionalStops String? // JSON array of strings

  date      DateTime // trip date
  pickupTime String
  endTime    String?
  passengers Int      @default(1)

  flightNumber       String?
  flightAirline      String?
  flightAirport      String?
  flightArrivalTime  DateTime?
  flightDepartureTime DateTime?
  flightStatus       String? // ON_TIME | DELAYED | LANDED | CANCELLED

  specialInstructions String?
  amenities           String? // JSON array

  baseRate       Float @default(0)
  driverFee      Float @default(0)
  mileageFee     Float @default(0)
  additionalFees Float @default(0)
  discount       Float @default(0)
  taxAmount      Float @default(0)
  totalPrice     Float @default(0)
  deposit        Float @default(0)
  remainingBalance Float @default(0)

  paymentStatus String @default("PAYMENT_PENDING") // PAYMENT_PENDING | DEPOSIT_PAID | PAID_IN_FULL | REFUNDED | FAILED
  bookingStatus String @default("RESERVED") // RESERVED | CONFIRMED | DRIVER_ASSIGNED | EN_ROUTE | PASSENGER_PICKED_UP | COMPLETED | CANCELLED
  opsStage      String @default("UPCOMING") // UPCOMING | DRIVER_ASSIGNED | DRIVER_EN_ROUTE | ARRIVED | PASSENGER_ONBOARD | IN_TRANSIT | COMPLETED

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote               Quote?   @relation("QuoteConvertedBooking")
  trip                Trip?
  payments            Payment[]
  tasks               Task[]
  activities          Activity[]
  communications       Communication[]
  documents           Document[]

  @@index([date])
  @@index([bookingStatus])
  @@index([vehicleId, date])
  @@index([driverId, date])
}

// Live operational execution of a booking — what the driver mobile view
// and the Live Vehicle Location map read/write.
model Trip {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status    String    @default("SCHEDULED") // SCHEDULED | ACCEPTED | DRIVER_EN_ROUTE | ARRIVED | PASSENGER_PICKED_UP | IN_TRANSIT | COMPLETED | CANCELLED
  acceptedAt   DateTime?
  startedAt    DateTime?
  arrivedAt    DateTime?
  pickedUpAt   DateTime?
  completedAt  DateTime?

  currentLat        Float?
  currentLng        Float?
  lastGpsUpdateAt   DateTime?
  estimatedArrival  DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  quoteId    String?
  quote      Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  amount Float
  type   String @default("DEPOSIT") // DEPOSIT | BALANCE | FULL | REFUND
  method String @default("CARD") // CARD | CASH | CHECK | WIRE | OTHER
  status String @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED

  // Placeholder seam for a real processor (Stripe PaymentIntent id, etc.)
  // — never populated with real secrets; see src/lib/integrations/payments.ts
  processorRef  String?
  paymentLinkUrl String?

  notes       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([customerId])
  @@index([bookingId])
}

// ─────────────────────────────────────────────────────────────────────────
// TASKS / ACTIVITY / COMMUNICATIONS / NOTES / DOCUMENTS
// ─────────────────────────────────────────────────────────────────────────

model Task {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  title    String
  type     String   @default("OTHER") // CALL | FOLLOW_UP | SEND_QUOTE | COLLECT_DEPOSIT | ASSIGN_DRIVER | CONFIRM_FLIGHT | PREPARE_VEHICLE | SEND_REMINDER | COLLECT_BALANCE | REQUEST_REVIEW | OTHER
  priority String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueDate  DateTime
  dueTime  String?
  status   String   @default("PENDING") // PENDING | COMPLETED | SNOOZED | CANCELLED
  notes    String?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  source      String    @default("MANUAL") // MANUAL | AUTOMATION | SEQUENCE
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId, status, dueDate])
}

model Activity {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  type        String // STAGE_CHANGE | NOTE_ADDED | CALL_LOGGED | TASK_COMPLETED | QUOTE_SENT | BOOKING_CREATED | PAYMENT_RECEIVED | DRIVER_ASSIGNED | AUTOMATION | BOOKED | LOST | ...
  description String
  metadata    String? // JSON

  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([bookingId])
}

model Communication {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  type      String // CALL | TEXT | EMAIL | VOICEMAIL | IN_PERSON | OTHER
  direction String  @default("OUTBOUND") // OUTBOUND | INBOUND
  channel   String? // SMS | EMAIL (for automated sends)
  summary   String
  body      String?

  actorId String?
  actor   User?  @relation("CommunicationActor", fields: [actorId], references: [id])

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([customerId, occurredAt])
}

model Note {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?

  body String

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

model Document {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name String
  type String  @default("OTHER") // ID | LICENSE | INSURANCE | REGISTRATION | CONTRACT | RECEIPT | OTHER
  url  String? // placeholder file reference

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// FOLLOW-UPS / SEQUENCES / AUTOMATION
// ─────────────────────────────────────────────────────────────────────────

model FollowUp {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  topic String
  notes String?

  followUpDate DateTime
  followUpTime String

  reminderOffsetMinutes Int?
  reminderSentAt        DateTime?

  priority String @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status   String @default("SCHEDULED") // SCHEDULED | COMPLETED | RESCHEDULED | CANCELLED | MISSED

  assigneeId String?
  assignee   User?  @relation("FollowUpAssignee", fields: [assigneeId], references: [id])

  completedAt     DateTime?
  completionNotes String?

  rescheduledFromId String?   @unique
  rescheduledFrom   FollowUp? @relation("FollowUpReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     FollowUp? @relation("FollowUpReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status, followUpDate])
  @@index([customerId])
  @@index([followUpDate])
}

model FollowUpSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  trigger     String   @default("NEW_LEAD") // NEW_LEAD | NO_RESPONSE | MANUAL
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  steps       FollowUpStep[]
  enrollments FollowUpEnrollment[]
}

model FollowUpStep {
  id             String           @id @default(cuid())
  sequenceId     String
  sequence       FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  offsetMinutes  Int // minutes after enrollment (e.g. 0, 120, 960, 2880)
  channel        String // SMS | EMAIL | CALL | TASK
  title          String
  messageBody    String?
  order          Int

  @@index([sequenceId, order])
}

model FollowUpEnrollment {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id])

  currentStepIndex Int       @default(0)
  status           String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED | STOPPED_RESPONDED
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
}

model AutomationRule {
  id           String   @id @default(cuid())
  name         String
  description  String?
  triggerEvent String // NEW_LEAD | HIGH_VALUE_LEAD | STAGE_CHANGE | QUOTE_SENT | BOOKING_CONFIRMED | REMINDER_24H | REMINDER_2H | TRIP_COMPLETED | NO_CONTACT_X_HOURS | PAYMENT_RECEIVED | PAYMENT_FAILED | MAINTENANCE_DUE
  conditions   String? // JSON-encoded condition set
  actions      String // JSON-encoded array of actions
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs AutomationRun[]
}

model AutomationRun {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  customerId String?
  leadId     String?
  bookingId  String?
  status     String         @default("SUCCESS") // SUCCESS | SKIPPED | FAILED
  detail     String?
  createdAt  DateTime       @default(now())

  @@index([ruleId, createdAt])
}

model MessageTemplate {
  id      String  @id @default(cuid())
  key     String  @unique // LEAD_CONFIRMATION | QUOTE_SENT | BOOKING_CONFIRMED | REMINDER_24H | REMINDER_2H | THANK_YOU_REVIEW | DEPOSIT_REQUEST | DRIVER_ASSIGNED
  name    String
  channel String // SMS | EMAIL
  subject String?
  body    String
  active  Boolean @default(true)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS / SETTINGS
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String // NEW_LEAD | HIGH_VALUE_LEAD | NEW_BOOKING | PAYMENT_RECEIVED | PAYMENT_FAILED | DRIVER_LATE | VEHICLE_UNAVAILABLE | BOOKING_CONFLICT | CUSTOMER_RESPONDED | FOLLOW_UP_DUE | MAINTENANCE_DUE
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}

// Integration configuration placeholders (all disabled/absent by default).
// Populated later when external API keys become available; never required
// for core functionality. Non-secret config only — real keys belong in
// environment variables, never in this table.
model Integration {
  id        String   @id @default(cuid())
  provider  String   @unique // TWILIO | SENDGRID | RESEND | STRIPE | GOOGLE_CALENDAR | GPS_TELEMATICS | FLIGHT_TRACKING | OPENAI
  category  String // SMS | EMAIL | PAYMENTS | CALENDAR | GPS | FLIGHTS | AI
  enabled   Boolean  @default(false)
  config    String? // JSON-encoded, non-secret config only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
