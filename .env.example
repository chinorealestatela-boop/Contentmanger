DATABASE_URL="file:./dev.db"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# ── SMS (Twilio) ────────────────────────────────────────────────────────
# Leave unset to run in simulated mode: messages are logged to the
# SmsMessage table (status "SIMULATED") and printed to the server console
# instead of actually being sent. Set all three to send real texts.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Delivery-status webhook: in the Twilio console this doesn't need its own
# setting — every send already passes StatusCallback=<this app>/api/webhooks/twilio,
# and that route verifies requests with TWILIO_AUTH_TOKEN above.

# ── Email (Resend) ──────────────────────────────────────────────────────
# Leave unset to run in simulated mode (logged to EmailMessage, status
# "SIMULATED"). Set both to send real email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Chino at AutoMax LV <bookings@yourdomain.com>"
# Delivery-status webhook: add an endpoint in the Resend dashboard pointing
# to <this app>/api/webhooks/resend, then paste its signing secret here.
# RESEND_WEBHOOK_SECRET=

# ── Push notifications (Web Push / VAPID) ────────────────────────────────
# Unlike Twilio/Resend, this needs no account or signup — it's just this
# app's own cryptographic identity for the Push API. Generate a pair with:
#   npx web-push generate-vapid-keys
# Leave unset to run in simulated mode (logged to the console + the
# Notification row's pushError field, nothing sent). Once set, "Enable
# push notifications on this device" in Settings → Notifications works for
# real. VAPID_SUBJECT should be a mailto: or https: URL identifying you.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:chino.realestatela@gmail.com"

# ── Cron ────────────────────────────────────────────────────────────────
# Shared secret required by GET /api/cron/reminders so an external
# scheduler can trigger the 24h/2h test-drive reminder sweep. Generate
# with: openssl rand -hex 24
CRON_SECRET="change-me"
